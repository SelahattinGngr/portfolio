@url = http://localhost:5353/api/auth

### signin
POST {{url}}/signin HTTP/1.1
Content-Type: application/json

{
  "signin": "admin",
  "password": "Adminpass1."
}

### signin
POST {{url}}/signin HTTP/1.1
Content-Type: application/json

{
  "signin": "selahattin1",
  "password": "AdminPass1."
}

### 2fa verification
POST {{url}}/verify-2fa HTTP/1.1
Content-Type: application/json

{
  "username": "selahattin",
  "code": "234360"
}

### setup 2fa
POST {{url}}/setup-google-2fa HTTP/1.1
Content-Type: application/json

{
}

### signup
